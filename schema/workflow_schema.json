{
  "$defs": {
    "AgentNodeConfig": {
      "description": "Configuration for an Agent node.",
      "properties": {
        "model_id": {
          "description": "Reference to a ModelConfig",
          "title": "Model Id",
          "type": "string"
        },
        "system_prompt": {
          "description": "System prompt for the agent",
          "title": "System Prompt",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override model temperature",
          "title": "Temperature"
        },
        "tool_ids": {
          "description": "References to ToolDefinitions this agent can use",
          "items": {
            "type": "string"
          },
          "title": "Tool Ids",
          "type": "array"
        },
        "max_iterations": {
          "default": 10,
          "description": "Maximum agent iterations",
          "maximum": 100,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Retry configuration"
        },
        "prompt_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to a workflow PromptDefinition; when set, its template is the base system prompt",
          "title": "Prompt Ref"
        },
        "skills": {
          "description": "Inlined skills folded into this agent at runtime",
          "items": {
            "$ref": "#/$defs/AgentSkill"
          },
          "title": "Skills",
          "type": "array"
        },
        "source_capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registry capability name this entry was imported from (provenance)",
          "title": "Source Capability"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capability version it was imported at",
          "title": "Source Version"
        },
        "track_latest": {
          "default": false,
          "description": "Live ref: at run start, re-resolve this agent node from the registry (newest published version within the same major) instead of using the inlined copy",
          "title": "Track Latest",
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "system_prompt"
      ],
      "title": "AgentNodeConfig",
      "type": "object"
    },
    "AgentSkill": {
      "description": "An inlined skill attached to an agent node (imported from a capability).\n\nFolded into the agent at runtime: its prompt is appended to the system\nprompt and its tools are unioned into the agent's tool set.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Skill name (provenance)",
          "title": "Name"
        },
        "prompt": {
          "description": "Instructions folded into the agent's system prompt",
          "title": "Prompt",
          "type": "string"
        },
        "tool_ids": {
          "description": "References to workflow ToolDefinitions this skill uses",
          "items": {
            "type": "string"
          },
          "title": "Tool Ids",
          "type": "array"
        },
        "source_capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registry capability name this entry was imported from (provenance)",
          "title": "Source Capability"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capability version it was imported at",
          "title": "Source Version"
        },
        "track_latest": {
          "default": false,
          "description": "Live ref: at run start, re-resolve this skill from the registry (newest published version within the same major) instead of using the inlined copy",
          "title": "Track Latest",
          "type": "boolean"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AgentSkill",
      "type": "object"
    },
    "ConditionConfig": {
      "description": "Configuration for a conditional edge or Conditional node.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ConditionType"
        },
        "expression": {
          "description": "The condition expression (syntax depends on type)",
          "title": "Expression",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "type",
        "expression"
      ],
      "title": "ConditionConfig",
      "type": "object"
    },
    "ConditionType": {
      "enum": [
        "json_path",
        "regex",
        "llm"
      ],
      "title": "ConditionType",
      "type": "string"
    },
    "ConditionalNodeConfig": {
      "description": "Configuration for a Conditional node.",
      "properties": {
        "conditions": {
          "description": "Conditions that determine which branch to take",
          "items": {
            "$ref": "#/$defs/ConditionConfig"
          },
          "title": "Conditions",
          "type": "array"
        },
        "default_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default branch name if no condition matches",
          "title": "Default Branch"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "ConditionalNodeConfig",
      "type": "object"
    },
    "CustomFunctionNodeConfig": {
      "description": "Configuration for a Custom Function node.",
      "properties": {
        "code": {
          "description": "Python code to execute (sandboxed)",
          "title": "Code",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "description": "Execution timeout",
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "input_fields": {
          "description": "State fields the function reads",
          "items": {
            "type": "string"
          },
          "title": "Input Fields",
          "type": "array"
        },
        "output_fields": {
          "description": "State fields the function writes",
          "items": {
            "type": "string"
          },
          "title": "Output Fields",
          "type": "array"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code"
      ],
      "title": "CustomFunctionNodeConfig",
      "type": "object"
    },
    "Edge": {
      "description": "A connection between two nodes.",
      "properties": {
        "id": {
          "description": "Unique edge identifier",
          "title": "Id",
          "type": "string"
        },
        "source_node_id": {
          "description": "Source node id",
          "title": "Source Node Id",
          "type": "string"
        },
        "source_handle": {
          "description": "Source handle name: 'default', 'error', or branch name",
          "title": "Source Handle",
          "type": "string"
        },
        "target_node_id": {
          "description": "Target node id",
          "title": "Target Node Id",
          "type": "string"
        },
        "type": {
          "default": "static",
          "description": "Edge type",
          "enum": [
            "static",
            "conditional",
            "error"
          ],
          "title": "Type",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Condition for conditional edges"
        }
      },
      "required": [
        "id",
        "source_node_id",
        "source_handle",
        "target_node_id"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EndNodeConfig": {
      "description": "Configuration for the End node.",
      "properties": {
        "output_fields": {
          "description": "Fields that the workflow produces as output",
          "items": {
            "type": "string"
          },
          "title": "Output Fields",
          "type": "array"
        }
      },
      "title": "EndNodeConfig",
      "type": "object"
    },
    "FieldMapping": {
      "description": "Maps an input state field to an output field.",
      "properties": {
        "source": {
          "description": "Source state field name",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "description": "Target output field name",
          "title": "Target",
          "type": "string"
        },
        "transform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional transform expression (template string)",
          "title": "Transform"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "FieldMapping",
      "type": "object"
    },
    "HumanInLoopNodeConfig": {
      "description": "Configuration for a Human-in-the-Loop node.",
      "properties": {
        "input_fields": {
          "description": "Fields the human is asked to provide",
          "items": {
            "$ref": "#/$defs/HumanInputField"
          },
          "title": "Input Fields",
          "type": "array"
        },
        "approval_required": {
          "default": false,
          "description": "If true, the human must approve/reject before continuing",
          "title": "Approval Required",
          "type": "boolean"
        },
        "approval_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Message shown to the human for approval",
          "title": "Approval Message"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set, the run auto-fails when no human input arrives within this many seconds. None = wait indefinitely.",
          "title": "Timeout Seconds"
        },
        "output_fields": {
          "description": "State fields to write with human input",
          "items": {
            "type": "string"
          },
          "title": "Output Fields",
          "type": "array"
        }
      },
      "title": "HumanInLoopNodeConfig",
      "type": "object"
    },
    "HumanInputField": {
      "description": "A field the human is asked to provide.",
      "properties": {
        "name": {
          "description": "Field name",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "description": "Human-readable label",
          "title": "Label",
          "type": "string"
        },
        "type": {
          "description": "Input type",
          "enum": [
            "text",
            "textarea",
            "select",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For 'select' type",
          "title": "Options"
        }
      },
      "required": [
        "name",
        "label",
        "type"
      ],
      "title": "HumanInputField",
      "type": "object"
    },
    "InvokeExitNodeConfig": {
      "description": "Runtime-only exit gate for an expanded invoke region; never saved to workflow JSON.",
      "properties": {
        "invoke_id": {
          "description": "Id of the invoke node this gate closes",
          "title": "Invoke Id",
          "type": "string"
        },
        "output_field": {
          "default": "result",
          "description": "Parent data key that receives the sub-workflow's final data",
          "title": "Output Field",
          "type": "string"
        },
        "set_output": {
          "default": false,
          "title": "Set Output",
          "type": "boolean"
        }
      },
      "required": [
        "invoke_id"
      ],
      "title": "InvokeExitNodeConfig",
      "type": "object"
    },
    "InvokeNodeConfig": {
      "description": "Configuration for an Invoke node (calls a registry capability).\n\nTool kind: the tool is executed in place. Workflow kind: at run start the\nsub-workflow is expanded into the graph around this node (entry gate) and\na synthetic invoke_exit node (exit gate); resolved versions are pinned on\nthe run so every rebuild produces an identical structure.",
      "properties": {
        "capability": {
          "description": "Capability name, 'owner/name'",
          "title": "Capability",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "description": "Semver or 'latest'",
          "title": "Version",
          "type": "string"
        },
        "input_mapping": {
          "description": "Maps parent state paths (source) to the capability's declared inputs (target)",
          "items": {
            "$ref": "#/$defs/FieldMapping"
          },
          "title": "Input Mapping",
          "type": "array"
        },
        "output_field": {
          "default": "result",
          "description": "Parent data key that receives the sub-workflow's final data",
          "title": "Output Field",
          "type": "string"
        },
        "set_output": {
          "default": false,
          "description": "Also copy the sub's final output string into the parent output",
          "title": "Set Output",
          "type": "boolean"
        }
      },
      "required": [
        "capability"
      ],
      "title": "InvokeNodeConfig",
      "type": "object"
    },
    "JsonSchemaParam": {
      "description": "A parameter in a tool's JSON Schema.",
      "properties": {
        "type": {
          "$ref": "#/$defs/StateFieldType"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        }
      },
      "required": [
        "type"
      ],
      "title": "JsonSchemaParam",
      "type": "object"
    },
    "ModelConfig": {
      "description": "A model definition that agents can reference.",
      "properties": {
        "id": {
          "description": "Unique identifier for this model config",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable name, e.g. 'Local Llama'",
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider",
          "description": "Provider type"
        },
        "model": {
          "description": "Model name/identifier",
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base URL for the API (required for openai_compatible)",
          "title": "Base Url"
        },
        "api_key_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to a secret key (name in secrets store)",
          "title": "Api Key Ref"
        },
        "default_temperature": {
          "default": 0.7,
          "maximum": 2,
          "minimum": 0,
          "title": "Default Temperature",
          "type": "number"
        },
        "track_cost": {
          "default": false,
          "description": "Whether to track token costs for this model",
          "title": "Track Cost",
          "type": "boolean"
        },
        "pricing": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost per 1M tokens, e.g. {'input': 0.0, 'output': 0.0}. Local models = $0.",
          "title": "Pricing"
        },
        "source_capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registry capability name this entry was imported from (provenance)",
          "title": "Source Capability"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capability version it was imported at",
          "title": "Source Version"
        },
        "track_latest": {
          "default": false,
          "description": "Live ref: at run start, re-resolve this entry from the registry (newest published version within the same major) instead of using the inlined copy",
          "title": "Track Latest",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "model"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelProvider": {
      "enum": [
        "openai_compatible",
        "anthropic"
      ],
      "title": "ModelProvider",
      "type": "string"
    },
    "Node": {
      "description": "A node in the workflow graph.",
      "properties": {
        "id": {
          "description": "Unique node identifier",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Node type",
          "enum": [
            "start",
            "end",
            "agent",
            "conditional",
            "transform",
            "human_in_loop",
            "custom_function",
            "invoke",
            "invoke_exit"
          ],
          "title": "Type",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/NodePosition",
          "description": "Position on canvas"
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/StartNodeConfig"
            },
            {
              "$ref": "#/$defs/EndNodeConfig"
            },
            {
              "$ref": "#/$defs/AgentNodeConfig"
            },
            {
              "$ref": "#/$defs/ConditionalNodeConfig"
            },
            {
              "$ref": "#/$defs/TransformNodeConfig"
            },
            {
              "$ref": "#/$defs/HumanInLoopNodeConfig"
            },
            {
              "$ref": "#/$defs/CustomFunctionNodeConfig"
            },
            {
              "$ref": "#/$defs/InvokeNodeConfig"
            },
            {
              "$ref": "#/$defs/InvokeExitNodeConfig"
            }
          ],
          "description": "Node-specific configuration",
          "title": "Config"
        },
        "error_handling": {
          "default": false,
          "description": "Opt in to an error handle so failures can be routed via a type='error' edge",
          "title": "Error Handling",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional display name for canvas and run logs; falls back to the node type name",
          "title": "Label"
        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodePosition": {
      "properties": {
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "NodePosition",
      "type": "object"
    },
    "PromptDefinition": {
      "description": "A named prompt template stored at workflow level (`prompts[]`), referenced by agent nodes.",
      "properties": {
        "id": {
          "description": "Unique identifier within the workflow",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable name",
          "title": "Name"
        },
        "text": {
          "description": "Template with {{var}} placeholders resolved from state data at runtime",
          "title": "Text",
          "type": "string"
        },
        "variables": {
          "description": "Declared {{var}} placeholders",
          "items": {
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        },
        "source_capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registry capability name this entry was imported from (provenance)",
          "title": "Source Capability"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capability version it was imported at",
          "title": "Source Version"
        },
        "track_latest": {
          "default": false,
          "description": "Live ref: at run start, re-resolve this entry from the registry (newest published version within the same major) instead of using the inlined copy",
          "title": "Track Latest",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "PromptDefinition",
      "type": "object"
    },
    "RetryConfig": {
      "description": "Retry configuration for a node.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable retries for this node",
          "title": "Enabled",
          "type": "boolean"
        },
        "max_retries": {
          "default": 3,
          "description": "Maximum number of retry attempts",
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "backoff_base": {
          "default": 1.0,
          "description": "Base delay in seconds, doubled each retry",
          "exclusiveMinimum": 0,
          "title": "Backoff Base",
          "type": "number"
        },
        "retry_on": {
          "description": "Error types to retry on",
          "items": {
            "type": "string"
          },
          "title": "Retry On",
          "type": "array"
        }
      },
      "title": "RetryConfig",
      "type": "object"
    },
    "StartNodeConfig": {
      "description": "Configuration for the Start node.",
      "properties": {
        "input_fields": {
          "description": "Fields that the workflow accepts as input",
          "items": {
            "type": "string"
          },
          "title": "Input Fields",
          "type": "array"
        }
      },
      "title": "StartNodeConfig",
      "type": "object"
    },
    "StateField": {
      "description": "A single field in the workflow's shared state.",
      "properties": {
        "name": {
          "description": "Field name, used by nodes to read/write state",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/StateFieldType",
          "description": "JSON type of the field"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
