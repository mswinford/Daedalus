          "title": "Description"
        },
        "required": {
          "default": false,
          "description": "Whether the field must be present",
          "title": "Required",
          "type": "boolean"
        },
        "items_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateFieldType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If type is 'array', the type of array items"
