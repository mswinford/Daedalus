          "type": "object"
        },
        "implementation": {
          "$ref": "#/$defs/ToolImplementation",
          "description": "How the tool is implemented"
        },
        "source_capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registry capability name this entry was imported from (provenance)",
          "title": "Source Capability"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
