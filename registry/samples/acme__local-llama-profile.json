{
  "name": "acme/local-llama-profile",
  "version": "1.0.0",
  "kind": "model_profile",
  "description": "A local, no-API-key model profile pointing at an Ollama server running Llama 3.2. Good default for offline demos.",
  "tags": ["example", "local", "ollama"],
  "spec": {
    "kind": "model_profile",
    "model": {
      "id": "local-llama",
      "name": "Local Llama 3.2",
      "provider": "openai_compatible",
      "model": "llama3.2",
      "base_url": "http://localhost:11434/v1",
      "api_key_ref": null,
      "default_temperature": 0.7,
      "track_cost": false,
      "pricing": { "input": 0.0, "output": 0.0 }
    },
    "notes": "Requires a local Ollama instance with `ollama pull llama3.2`."
  },
  "governance": {
    "owner": "acme",
    "data_classification": "public",
    "security_status": "approved"
  },
  "stage": "published"
}
