{
  "name": "forge/github-create-pr",
  "version": "1.0.0",
  "kind": "tool",
  "description": "Open a pull request in a GitHub repository from an existing branch. Requires the GITHUB_TOKEN secret and Daedalus's github_create_pr builtin (ships with the backend).",
  "tags": ["github", "builtin", "vcs"],
  "spec": {
    "kind": "tool",
    "tool": {
      "id": "github_create_pr",
      "name": "github_create_pr",
      "description": "Open a pull request in a GitHub repository. The head branch must already exist; base defaults to the repository's default branch.",
      "parameters": {
        "owner": {
          "type": "string",
          "description": "GitHub owner or organization of the repository",
          "required": true
        },
        "repo": {
          "type": "string",
          "description": "Repository name (without the owner prefix)",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Pull request title",
          "required": true
        },
        "head": {
          "type": "string",
          "description": "Source branch (must already exist)",
          "required": true
        },
        "base": {
          "type": "string",
          "description": "Target branch; defaults to the repository's default branch"
        },
        "body": {
          "type": "string",
          "description": "Pull request description (markdown)"
        }
      },
      "implementation": {
        "type": "builtin",
        "config": { "function": "github_create_pr" }
      }
    }
  },
  "interface": {
    "type": "http",
    "input_schema": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "title": { "type": "string" },
        "head": { "type": "string" },
        "base": { "type": "string" },
        "body": { "type": "string" }
      },
      "required": ["owner", "repo", "title", "head"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "number": { "type": "number" },
        "url": { "type": "string" },
        "state": { "type": "string" }
      }
    }
  },
  "secrets_required": ["GITHUB_TOKEN"],
  "governance": {
    "owner": "forge",
    "data_classification": "internal",
    "security_status": "approved"
  },
  "stage": "published"
}
